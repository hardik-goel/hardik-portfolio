{
  "redirects": [
    { "source": "/resume", "destination": "/resources/Hardik_Goel_Resume.pdf", "permanent": false },
    { "source": "/resume.pdf", "destination": "/resources/Hardik_Goel_Resume.pdf", "permanent": false }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
